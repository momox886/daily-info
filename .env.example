# ── Obligatoire ────────────────────────────────────────────────────────────────
# URL du webhook Discord (Paramètres du salon > Intégrations > Webhooks > Nouveau webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Résumé LLM (Groq free tier) ────────────────────────────────────────────────
# Clé API gratuite à créer sur https://console.groq.com/keys
# (modèle par défaut qwen/qwen3.8-27b, limites du plan gratuit).
# Vide = le bot envoie les articles sans résumé LLM.
GROQ_API_KEY=

# Modèle utilisé (défaut : qwen/qwen3.8-27b, disponible sur Groq)
LLM_MODEL=qwen/qwen3.8-27b

# Activer le résumé LLM (true/false)
ENABLE_SUMMARIZATION=true

# Nombre max d'articles résumés par cycle (garder < 15 pour respecter le quota)
MAX_ARTICLES_TO_SUMMARIZE=15

# Fusionner les articles couvrant le même sujet (même storyId) et ne garder
# que la meilleure source (true/false)
ENABLE_SMART_DEDUP=true

# Message "À la une" en tête du digest : N meilleurs articles du jour (true/false)
ENABLE_TOP3=true

# Nombre d'articles affichés dans le message "À la une"
TOP_N=3

# ── Santé des sources ─────────────────────────────────────────────────────────
# Alerter sur Discord quand une source RSS échoue plusieurs fois de suite
ENABLE_SOURCE_ALERTS=true

# Nombre d'échecs consécutifs avant d'envoyer une alerte
SOURCE_ALERT_THRESHOLD=3

# Bandeau d'en-tête : marqueur de séparation (démarque le lot du jour des
# articles déjà postés) + résumé (date, compte, santé des sources)
ENABLE_DAY_BANNER=true

# ── Optionnel ──────────────────────────────────────────────────────────────────
# Fenêtre de temps (en heures) pour considérer un article comme "récent".
# Par défaut : 24
LOOKBACK_HOURS=24

# Filtrer uniquement les articles dont le titre OU la description contient au
# moins un de ces mots-clés (séparés par des virgules). Vide = tous les articles.
INCLUDE_KEYWORDS=

# Exclure les articles dont le titre OU la description contient un de ces
# mots-clés (séparés par des virgules). Ex : "crypto,sponsorisé"
EXCLUDE_KEYWORDS=

# Mots-clés (séparés par des virgules) qui déclenchent la couleur "prioritaire"
# (orange) d'un embed. Préfixez un mot-clé par "!" pour le passer en "critique"
# (rouge). Ex : !CVE, !zero-day, ransomware, faille
# Par défaut : critique = CVE, zero-day, exploit, vulnérabilité critique ;
#              prioritaire = ransomware, faille
PRIORITY_KEYWORDS=!CVE, !zero-day, !exploit, !vulnérabilité critique, ransomware, faille

# Planification journalière (cron, fuseau Europe/Paris). Par défaut : 08:00
# Format : minute heure * * *  →  0 8 * * * = tous les jours à 8h00
SCHEDULE_CRON=0 8 * * *

# Nom du bot affiché dans Discord (limitée à 80 caractères par Discord)
BOT_USERNAME=Cyber News Bot

# Emoji / texte affiché avant le nom du bot
BOT_ICON_URL=

# Langue du message d'en-tête : fr ou en
LANGUAGE=fr

# Nombre maximum d'embeds par message Discord (limite Discord = 10)
MAX_EMBEDS_PER_MESSAGE=10

# Si vrai, n'envoie rien sur Discord et affiche ce qui aurait été envoyé
DRY_RUN=false
